# Copia este archivo a .env.local (local) o crea la variable en Vercel → Settings → Environment Variables.
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE   (codifica en URL los caracteres especiales de la contraseña)
# Opcional para Vercel: añade ?connection_limit=5 para no agotar las conexiones de MySQL.
DATABASE_URL=

# Clave para firmar las sesiones (JWT). Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
