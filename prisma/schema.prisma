// HausPe Coffee E-Business · Modelo de datos (Prisma + MySQL 8)
// Equivale a src/db/schema.sql. Los nombres de modelos y campos son los mismos que los
// de las tablas y columnas del diagrama ER, así que no hace falta @map/@@map.
// Lo que Prisma no puede expresar (CHECK, triggers, vistas) está en prisma/sql/extras.sql.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- CLIENTES Y PLANES ----------
model Plan {
  id_plan        Int     @id @default(autoincrement())
  nombre         String  @unique @db.VarChar(30)
  segmento       String  @db.VarChar(3)
  precio_mensual Decimal @default(0) @db.Decimal(10, 2)
  moneda         String  @default("PEN") @db.VarChar(3)
  beneficios     Json
  activo         Boolean @default(true)

  membresias  Membresia[]
  promociones Promocion[]
}

model Cliente {
  id_cliente    Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(120)
  email         String   @unique @db.VarChar(150)
  telefono      String?  @db.VarChar(30)
  password_hash String   @db.VarChar(100)
  tipo_segmento String   @db.VarChar(3)
  tipo_b2b      String?  @db.VarChar(12)
  empresa       String?  @db.VarChar(150)
  ruc_taxid     String?  @db.VarChar(30)
  pais          String   @default("Perú") @db.VarChar(60)
  idioma        String   @default("es") @db.VarChar(5)
  creado_en     DateTime @default(now()) @db.DateTime(0)

  membresias    Membresia[]
  perfil        PerfilSabor?
  direcciones   Direccion[]
  suscripciones SuscripcionCafe[]
  pedidos       Pedido[]
  deseos        ListaDeseos[]
  valoraciones  Valoracion[]
  leads         Lead[]
  notas         ClienteNota[]
  recordatorios Recordatorio[]
}

model Membresia {
  id_membresia Int       @id @default(autoincrement())
  id_cliente   Int
  id_plan      Int
  estado       String    @default("ACTIVA") @db.VarChar(10)
  inicio       DateTime  @db.Date
  fin          DateTime? @db.Date

  cliente Cliente @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  plan    Plan    @relation(fields: [id_plan], references: [id_plan], onDelete: Restrict)

  @@index([id_cliente], map: "idx_membresia_cliente")
  @@index([id_plan], map: "idx_membresia_plan")
}

model PerfilSabor {
  id_perfil         Int      @id @default(autoincrement())
  id_cliente        Int      @unique
  notas_preferidas  String?  @db.VarChar(200)
  tipo_molienda     String?  @db.VarChar(40)
  metodo_extraccion String?  @db.VarChar(60)
  intensidad        Int?
  actualizado_en    DateTime @default(now()) @db.DateTime(0)

  cliente Cliente @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
}

model ZonaReparto {
  id_zona     Int     @id @default(autoincrement())
  distrito    String  @unique @db.VarChar(80)
  costo_envio Decimal @db.Decimal(10, 2)
  activa      Boolean @default(true)

  direcciones Direccion[]
  entregas    Entrega[]
}

model Direccion {
  id_direccion   Int     @id @default(autoincrement())
  id_cliente     Int
  id_zona        Int?
  direccion      String  @db.VarChar(200)
  referencia     String? @db.VarChar(200)
  predeterminada Boolean @default(false)

  cliente Cliente      @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  zona    ZonaReparto? @relation(fields: [id_zona], references: [id_zona], onDelete: Restrict)
  pedidos Pedido[]

  @@index([id_cliente], map: "idx_direccion_cliente")
  @@index([id_zona], map: "idx_direccion_zona")
}

// ---------- CATÁLOGO ----------
model GuiaPreparacion {
  id_guia         Int     @id @default(autoincrement())
  metodo          String  @unique @db.VarChar(30)
  titulo          String  @db.VarChar(80)
  texto           String  @db.Text
  proporcion      String? @db.VarChar(20)
  tiempo_segundos Int?

  productos Producto[]
}

model Producto {
  id_producto Int     @id @default(autoincrement())
  sku         String  @unique @db.VarChar(60)
  nombre      String  @db.VarChar(120)
  tipo        String  @db.VarChar(10)
  categoria   String? @db.VarChar(60)
  descripcion String? @db.Text
  id_guia     Int?
  activo      Boolean @default(true)

  guia         GuiaPreparacion?    @relation(fields: [id_guia], references: [id_guia], onDelete: Restrict)
  variantes    VarianteProducto[]
  promos       PromocionProducto[]
  deseos       ListaDeseos[]
  valoraciones Valoracion[]
  lotes        LoteCafe[]

  @@index([id_guia], map: "idx_producto_guia")
}

model VarianteProducto {
  id_variante Int     @id @default(autoincrement())
  id_producto Int
  descripcion String  @db.VarChar(100)
  moneda      String  @default("PEN") @db.VarChar(3)
  precio      Decimal @db.Decimal(10, 2)
  unidad      String  @default("unidad") @db.VarChar(20)
  stock       Int     @default(0)

  producto      Producto          @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  receta        RecetaInsumo[]
  extras        VarianteExtra[]
  suscripciones SuscripcionCafe[]
  detalles      DetallePedido[]
  inventario    Inventario[]

  @@index([id_producto], map: "idx_variante_producto")
}

model Insumo {
  id_insumo    Int    @id @default(autoincrement())
  nombre       String @unique @db.VarChar(100)
  unidad       String @db.VarChar(2)
  stock        Float
  stock_minimo Float  @default(0)

  recetas RecetaInsumo[]
}

// Receta: gramaje de cada insumo por variante (bolsa de 250 g, latte 12 oz, etc.)
model RecetaInsumo {
  id_variante Int
  id_insumo   Int
  cantidad    Float

  variante VarianteProducto @relation(fields: [id_variante], references: [id_variante], onDelete: Cascade)
  insumo   Insumo           @relation(fields: [id_insumo], references: [id_insumo], onDelete: Restrict)

  @@id([id_variante, id_insumo])
  @@index([id_insumo], map: "idx_receta_insumo")
}

model Extra {
  id_extra Int     @id @default(autoincrement())
  nombre   String  @db.VarChar(80)
  precio   Decimal @db.Decimal(10, 2)
  activo   Boolean @default(true)

  variantes VarianteExtra[]
  detalles  DetalleExtra[]
}

model VarianteExtra {
  id_variante Int
  id_extra    Int

  variante VarianteProducto @relation(fields: [id_variante], references: [id_variante], onDelete: Cascade)
  extra    Extra            @relation(fields: [id_extra], references: [id_extra], onDelete: Cascade)

  @@id([id_variante, id_extra])
  @@index([id_extra], map: "idx_varextra_extra")
}

model Promocion {
  id_promocion Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(120)
  descuento    Decimal  @db.Decimal(3, 2)
  inicio       DateTime @db.Date
  fin          DateTime @db.Date
  id_plan      Int? // NULL = para todos

  plan      Plan?               @relation(fields: [id_plan], references: [id_plan], onDelete: Restrict)
  productos PromocionProducto[]

  @@index([id_plan], map: "idx_promocion_plan")
}

model PromocionProducto {
  id_promocion Int
  id_producto  Int

  promocion Promocion @relation(fields: [id_promocion], references: [id_promocion], onDelete: Cascade)
  producto  Producto  @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_promocion, id_producto])
  @@index([id_producto], map: "idx_promprod_producto")
}

model SuscripcionCafe {
  id_suscripcion Int       @id @default(autoincrement())
  id_cliente     Int
  id_variante    Int
  frecuencia     String    @db.VarChar(10)
  estado         String    @default("ACTIVA") @db.VarChar(10)
  inicio         DateTime  @db.Date
  proximo_envio  DateTime  @db.Date
  fin            DateTime? @db.Date

  cliente  Cliente          @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  variante VarianteProducto @relation(fields: [id_variante], references: [id_variante], onDelete: Restrict)
  pedidos  Pedido[]

  @@index([id_cliente], map: "idx_suscripcion_cliente")
  @@index([id_variante], map: "idx_suscripcion_variante")
}

// ---------- COMPRA ----------
model Pedido {
  id_pedido      Int      @id @default(autoincrement())
  codigo         String   @unique @db.VarChar(30)
  id_cliente     Int? // NULL = venta POS anónima
  id_direccion   Int?
  id_suscripcion Int?
  canal          String   @db.VarChar(4)
  tipo           String   @default("VENTA") @db.VarChar(10)
  moneda         String   @db.VarChar(3)
  incoterm       String?  @db.VarChar(3)
  pais_destino   String?  @db.VarChar(60)
  estado         String   @default("PENDIENTE") @db.VarChar(15)
  fecha          DateTime @default(now()) @db.DateTime(0)
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  descuento      Decimal  @default(0) @db.Decimal(12, 2)
  costo_envio    Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)

  cliente       Cliente?         @relation(fields: [id_cliente], references: [id_cliente], onDelete: Restrict)
  direccion     Direccion?       @relation(fields: [id_direccion], references: [id_direccion], onDelete: Restrict)
  suscripcion   SuscripcionCafe? @relation(fields: [id_suscripcion], references: [id_suscripcion], onDelete: Restrict)
  detalles      DetallePedido[]
  pagos         Pago[]
  comprobante   Comprobante?
  entrega       Entrega?
  recordatorios Recordatorio[]

  @@index([id_cliente], map: "idx_pedido_cliente")
  @@index([id_direccion], map: "idx_pedido_direccion")
  @@index([id_suscripcion], map: "idx_pedido_suscripcion")
}

model DetallePedido {
  id_detalle      Int     @id @default(autoincrement())
  id_pedido       Int
  id_variante     Int
  cantidad        Int
  precio_unitario Decimal @db.Decimal(10, 2)
  configuracion   Json? // molienda, frecuencia, etc.

  pedido   Pedido           @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  variante VarianteProducto @relation(fields: [id_variante], references: [id_variante], onDelete: Restrict)
  extras   DetalleExtra[]
  unidades PedidoUnidad[]

  @@index([id_pedido], map: "idx_detalle_pedido")
  @@index([id_variante], map: "idx_detalle_variante")
}

model DetalleExtra {
  id_detalle Int
  id_extra   Int
  cantidad   Int @default(1)

  detalle DetallePedido @relation(fields: [id_detalle], references: [id_detalle], onDelete: Cascade)
  extra   Extra         @relation(fields: [id_extra], references: [id_extra], onDelete: Restrict)

  @@id([id_detalle, id_extra])
  @@index([id_extra], map: "idx_detextra_extra")
}

model Pago {
  id_pago    Int      @id @default(autoincrement())
  id_pedido  Int
  metodo     String   @db.VarChar(15)
  monto      Decimal  @db.Decimal(12, 2)
  estado     String   @default("APROBADO") @db.VarChar(10)
  referencia String?  @db.VarChar(60)
  pagado_en  DateTime @default(now()) @db.DateTime(0)

  pedido Pedido @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)

  @@index([id_pedido], map: "idx_pago_pedido")
}

model Comprobante {
  id_comprobante Int      @id @default(autoincrement())
  id_pedido      Int      @unique
  tipo           String   @db.VarChar(10)
  serie          String   @db.VarChar(6)
  numero         Int
  doc_cliente    String?  @db.VarChar(30)
  base_imponible Decimal  @db.Decimal(12, 2)
  igv            Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  emitido_en     DateTime @default(now()) @db.DateTime(0)

  pedido Pedido @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)

  @@unique([serie, numero], map: "uq_comprobante_serie_numero")
}

model ListaDeseos {
  id_cliente  Int
  id_producto Int
  agregado_en DateTime @default(now()) @db.DateTime(0)

  cliente  Cliente  @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  producto Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_cliente, id_producto])
  @@index([id_producto], map: "idx_deseos_producto")
}

model Valoracion {
  id_valoracion Int      @id @default(autoincrement())
  id_cliente    Int
  id_producto   Int
  puntuacion    Int
  comentario    String?  @db.VarChar(500)
  fecha         DateTime @default(now()) @db.DateTime(0)

  cliente  Cliente  @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  producto Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@index([id_cliente], map: "idx_valoracion_cliente")
  @@index([id_producto], map: "idx_valoracion_producto")
}

model Lead {
  id_lead    Int      @id @default(autoincrement())
  nombre     String?  @db.VarChar(120)
  whatsapp   String?  @db.VarChar(30)
  email      String?  @db.VarChar(150)
  origen     String   @default("QR") @db.VarChar(6)
  codigo_qr  String?  @db.VarChar(60)
  id_cliente Int? // se llena si el lead se registra
  creado_en  DateTime @default(now()) @db.DateTime(0)

  cliente Cliente? @relation(fields: [id_cliente], references: [id_cliente], onDelete: Restrict)

  @@index([id_cliente], map: "idx_lead_cliente")
}

// ---------- CAFÉ, LOTES Y TRAZABILIDAD ----------
model LoteCafe {
  id_lote       Int       @id @default(autoincrement())
  codigo_lote   String    @unique @db.VarChar(40)
  id_producto   Int?
  finca_origen  String    @db.VarChar(120)
  productor     String?   @db.VarChar(120)
  altura_msnm   Int?
  variedad      String?   @db.VarChar(60)
  proceso       String?   @db.VarChar(60)
  puntaje_sca   Float?
  fecha_cosecha DateTime? @db.Date
  tipo          String    @db.VarChar(8)

  producto   Producto?           @relation(fields: [id_producto], references: [id_producto], onDelete: Restrict)
  unidades   UnidadEmpaque[]
  etapas     EtapaTrazabilidad[]
  telemetria TelemetriaIoT[]

  @@index([id_producto], map: "idx_lote_producto")
}

model UnidadEmpaque {
  id_unidad Int    @id @default(autoincrement())
  id_lote   Int
  codigo_qr String @unique @db.VarChar(60)
  tipo      String @db.VarChar(8)
  peso_kg   Float
  estado    String @default("EN_ALMACEN") @db.VarChar(12)

  lote   LoteCafe      @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)
  pedido PedidoUnidad?

  @@index([id_lote], map: "idx_unidad_lote")
}

model PedidoUnidad {
  id_detalle Int
  id_unidad  Int @unique

  detalle DetallePedido @relation(fields: [id_detalle], references: [id_detalle], onDelete: Cascade)
  unidad  UnidadEmpaque @relation(fields: [id_unidad], references: [id_unidad], onDelete: Restrict)

  @@id([id_detalle, id_unidad])
}

model Empleado {
  id_empleado   Int     @id @default(autoincrement())
  codigo        String  @unique @db.VarChar(10) // IC1, IE1, IP1, RD1, BA1 ...
  nombre        String  @db.VarChar(120)
  rol           String  @db.VarChar(20)
  // Acceso al panel /admin (solo el personal con cuenta; el resto solo firma o reparte)
  email         String? @unique @db.VarChar(150)
  password_hash String? @db.VarChar(100)

  firmas   FirmaEtapa[]
  entregas Entrega[]
  notas    ClienteNota[]
}

model EtapaTrazabilidad {
  id_etapa  Int      @id @default(autoincrement())
  id_lote   Int
  orden     Int
  tipo      String   @db.VarChar(12)
  ubicacion String?  @db.VarChar(150)
  fecha     DateTime @db.DateTime(0)
  detalle   String?  @db.VarChar(250)

  lote  LoteCafe    @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)
  firma FirmaEtapa?

  @@unique([id_lote, orden], map: "uq_etapa_lote_orden")
}

model FirmaEtapa {
  id_firma      Int      @id @default(autoincrement())
  id_etapa      Int      @unique
  id_empleado   Int
  firmado_en    DateTime @db.DateTime(0)
  hash          String   @unique @db.VarChar(64)
  hash_anterior String   @db.VarChar(64)

  etapa    EtapaTrazabilidad @relation(fields: [id_etapa], references: [id_etapa], onDelete: Cascade)
  empleado Empleado          @relation(fields: [id_empleado], references: [id_empleado], onDelete: Restrict)

  @@index([id_empleado], map: "idx_firma_empleado")
}

model TelemetriaIoT {
  id_registro           Int      @id @default(autoincrement())
  id_lote               Int
  nivel_humedad         Float
  nivel_co2_ppm         Float
  nivel_desgasificacion Float?
  leido_en              DateTime @default(now()) @db.DateTime(0)

  lote LoteCafe @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)

  @@index([id_lote, leido_en], map: "idx_telemetria_lote")
}

// ---------- OPERACIÓN, CRM Y CONTENIDO ----------
model Inventario {
  id_inventario  Int      @id @default(autoincrement())
  id_variante    Int
  ubicacion      String   @db.VarChar(80) // Dark Store Surco, Tostaduría, Almacén Villa Rica
  cantidad       Int
  actualizado_en DateTime @default(now()) @db.DateTime(0)

  variante VarianteProducto @relation(fields: [id_variante], references: [id_variante], onDelete: Cascade)

  @@unique([id_variante, ubicacion], map: "uq_inventario_variante_ubicacion")
}

model Entrega {
  id_entrega      Int       @id @default(autoincrement())
  id_pedido       Int       @unique
  id_zona         Int?
  id_empleado     Int?
  programada_para DateTime  @db.DateTime(0) // límite de 24 h desde el pago
  preparada_en    DateTime? @db.DateTime(0)
  despachada_en   DateTime? @db.DateTime(0)
  entregada_en    DateTime? @db.DateTime(0)

  pedido   Pedido       @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  zona     ZonaReparto? @relation(fields: [id_zona], references: [id_zona], onDelete: Restrict)
  empleado Empleado?    @relation(fields: [id_empleado], references: [id_empleado], onDelete: Restrict)

  @@index([id_zona], map: "idx_entrega_zona")
  @@index([id_empleado], map: "idx_entrega_empleado")
}

model ClienteNota {
  id_nota     Int      @id @default(autoincrement())
  id_cliente  Int
  id_empleado Int?
  nota        String   @db.VarChar(500)
  creada_en   DateTime @default(now()) @db.DateTime(0)

  cliente  Cliente   @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  empleado Empleado? @relation(fields: [id_empleado], references: [id_empleado], onDelete: Restrict)

  @@index([id_cliente], map: "idx_nota_cliente")
  @@index([id_empleado], map: "idx_nota_empleado")
}

model Recordatorio {
  id_recordatorio Int       @id @default(autoincrement())
  id_cliente      Int
  id_pedido       Int?
  tipo            String    @db.VarChar(20)
  mensaje         String    @db.VarChar(500)
  programado_en   DateTime  @db.DateTime(0)
  enviado_en      DateTime? @db.DateTime(0)
  canal           String    @default("WHATSAPP") @db.VarChar(10)
  estado          String    @default("PROGRAMADO") @db.VarChar(10)

  cliente Cliente @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  pedido  Pedido? @relation(fields: [id_pedido], references: [id_pedido], onDelete: Restrict)

  @@index([id_cliente], map: "idx_recordatorio_cliente")
  @@index([id_pedido], map: "idx_recordatorio_pedido")
}

model ArticuloBlog {
  id_articulo  Int      @id @default(autoincrement())
  titulo       String   @db.VarChar(200)
  slug         String   @unique @db.VarChar(120)
  contenido    String   @db.Text
  publicado_en DateTime @db.Date
}
